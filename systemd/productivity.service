[Unit]
Description=Productivity Guardian
Documentation=https://github.com/KachanArtmee/linux-productivity-guardian
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/productivity-guardian all
Environment=GUARDIAN_CONFIG=%h/.config/productivity-guardian/guardian.conf
Environment=GUARDIAN_LOG_TARGET=journald
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
